le-data/index.md:
   6  title: "Living Earth Products"
   7: subtitle: "Living Earth products are land cover, habitat and change maps and the environmental descriptors used in their construction and description."
   8  image: "/assets/img/le_data/australia_wofslccs.png"

  15  include le-data.liquid
  16: header="Living Earth constructs land cover maps according to the Food and Agriculture Organisation (FAO) Land Cover Classification System (LCCS) from environmental descriptors with pre-defined categories or units (e.g., metres, percent, time).  Overarching Environmental Descriptors (OEDs) are used to generate up to eight of the base level (LCCS Level 3) classes, with further detail added using Essential Environmental Descriptors (EEDs). The resulting maps can potentially represent over 12,000 classes with each having biophysical meaning.  Theses are further described using Additional Environmental Descriptors (AEDs), which are not part of the FAO LCCS. These can be divided into abiotic, biotic and human-influenced AEDs with examples being soil acidity, dominant plant species and urban density respectively."
  17  -%}

le-data/product-australia/index.md:
   6  title: "Australia Products"
   7: subtitle: "Australia's land cover products and associated environmental descriptors are generated primarily from time-series of Landsat sensor data held within Digital Earth Australia"
   8  image: "/assets/img/le_data/aus/aus-southauslarge.png

  15  include product-australia.liquid
  16: header="Digital Earth Australia provides access to a diverse range of environmental descriptors and derived land cover maps "
  17  -%}

