<header class="navigation-wrap">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <h1 class="d-none">LivingEarth</h1>
        <nav class="navbar navbar-expand-md navbar-light">
          <div class="logo-action">
            <button
              class="navbar-toggler"
              type="button"
              data-toggle="collapse"
              data-target="#navbarSupportedContent"
              aria-controls="navbarSupportedContent"
              aria-expanded="false"
              aria-label="Toggle navigation">
              <span class="navbar-toggler-icon"></span>
            </button>
            <a class="navbar-brand" href="/">
              <img src="/assets/img/logos/living-earth-logo.svg" alt="Living Earth">
            </a>
          </div>

          {% if page.url == '/tools/interactive-map' %}
            <div class="group-button_map">
              <span class="button-action open-select-country">
                <img src="../assets/img/flag.png" alt="" srcset="">
              </span>
              <span class="button-action open-add-layer">
                <img src="../assets/img/addLayer.png" alt="" srcset="">
              </span>
            </div>
          {%- endif -%}

          <div class="collapse navbar-collapse justify-content-center align-items-center" id="navbarSupportedContent">
            <ul class="navbar-nav py-4 py-md-0 align-items-center navbar-mobile-view">

              <li class="nav-item pl-4 pl-md-0 ml-0 ml-lg-5 active dropdown-mobile">
                <a class="nav-link dropdown-toggle dropdown-mobile" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Countries</a>
                <div class="dropdown-menu">
                  <a class="dropdown-item" href="/europe/wales/">Wales</a>
                  <a class="dropdown-item" href="/europe/switzerland/">Switzerland</a>
                  <a class="dropdown-item" href="/oceania/australia/">Australia</a>
                </div>
              </li>

              <li class="nav-item pl-4 pl-md-0 ml-0 ml-lg-5 active dropdown-mobile">
                <a class="nav-link dropdown-toggle dropdown-mobile" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">About</a>
                <div class="dropdown-menu">
                  <a class="dropdown-item" href="/about">About Living Earth</a>
                  <a class="dropdown-item" href="/our-projects">Our Projects</a>
                  <a class="dropdown-item" href="/contact">Contact Us</a>
                </div>
              </li>

              <li class="nav-item pl-4 pl-md-0 ml-0 ml-lg-5 active dropdown-mobile">
                <a class="nav-link dropdown-toggle dropdown-mobile" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Tools</a>
                <div class="dropdown-menu">
                  <a class="dropdown-item" href="/tools/">About Tools</a>
                  <a class="dropdown-item" href="/tools/explore-and-analyse">Explore and Analyse</a>
                  <a class="dropdown-item" href="/tools/learn">Learn</a>
                  <a class="dropdown-item" href="/tools/for-developers">For Developers</a>
                </div>
              </li>

              <li class="nav-item pl-4 pl-md-0 ml-0 ml-lg-5 active dropdown-mobile">
                <a class="nav-link dropdown-toggle dropdown-mobile" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Themes</a>
                <div class="dropdown-menu">
                  <a class="dropdown-item" href="/themes/landhabcover/">Land Cover and Habitats</a>
                  <a class="dropdown-item" href="/themes/water/">Water</a>
                  <a class="dropdown-item" href="/themes/change/">Change, Impacts and Pressures</a>
                  <a class="dropdown-item" href="/themes/biodiversity/">Biodiversity</a>
                  <a class="dropdown-item" href="/themes/accounts/">Accounts</a>
                  <a class="dropdown-item" href="/themes/futures/">Future Earth</a>
                </div>
              </li>

              <li class="nav-item pl-4 pl-md-0 ml-0 ml-lg-5 active">
                <a class="nav-link" href="/news">News and Events</a>
              </li>

            </ul>
          </div>

          <div class="form-control-search">
            <div class="has-search">
              <div class="form-control-feedback">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.6"/>
                  <path d="M18 18l-3.8-3.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </div>
              <input type="text" class="form-control" placeholder="Search">
            </div>
            <button class="commit-search" aria-label="Search">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 21 20" fill="none" aria-hidden="true">
