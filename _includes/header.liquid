<header class="navigation-wrap">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <h1 class="d-none">LivingEarth</h1>
        <nav class="navbar navbar-expand-md navbar-light">
          <div class="logo-action">
            <button
              class="navbar-toggler"
              type="button"
              data-toggle="collapse"
              data-target="#navbarSupportedContent"
              aria-controls="navbarSupportedContent"
              aria-expanded="false"
              aria-label="Toggle navigation">
              <span class="navbar-toggler-icon"></span>
            </button>
            <a class="navbar-brand" href="{{ '/' | relative_url }}">
              <img src="{{ '/assets/img/logos/living-earth-logo.svg' | relative_url }}" alt="Living Earth">
            </a>
          </div>

          {% if page.url == '/tools/interactive-map' %}
            <div class="group-button_map">
              <span class="button-action open-select-country">
                <img src="../assets/img/flag.png" alt="" srcset="">
              </span>
              <span class="button-action open-add-layer">
                <img src="../assets/img/addLayer.png" alt="" srcset="">
              </span>
            </div>
          {%- endif -%}

          <div class="collapse navbar-collapse justify-content-center align-items-center" id="navbarSupportedContent">
            <ul class="navbar-nav py-4 py-md-0 align-items-center navbar-mobile-view">

              <!-- ABOUT -->
              <li class="nav-item pl-4 pl-md-0 ml-0 ml-lg-5 active dropdown-mobile">
                <a class="nav-link dropdown-toggle dropdown-mobile" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">About</a>
                <div class="dropdown-menu">
                  <a class="dropdown-item" href="{{ '/about' | relative_url }}">About Living Earth</a>
                  <a class="dropdown-item" href="{{ '/our-projects' | relative_url }}">Our Projects</a>
                  <a class="dropdown-item" href="{{ '/publications/' | relative_url }}">Publications</a>
                  <a class="dropdown-item" href="{{ '/contact' | relative_url }}">Contact Us</a>
                </div>
              </li>

              <!-- COUNTRIES -->
              <li class="nav-item pl-4 pl-md-0 ml-0 ml-lg-5 active dropdown-mobile">
                <a class="nav-link dropdown-toggle dropdown-mobile" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Countries</a>
                <div class="dropdown-menu">
                  <a class="dropdown-item" href="{{ '/europe/wales/' | relative_url }}">Wales</a>
                  <a class="dropdown-item" href="{{ '/europe/switzerland/' | relative_url }}">Switzerland</a>
                  <a class="dropdown-item" href="{{ '/oceania/australia/' | relative_url }}">Australia</a>
                </div>
              </li>

              <!-- MAPS -->
              <li class="nav-item pl-4 pl-md-0 ml-0 ml-lg-5 active dropdown-mobile">
                <a class="nav-link dropdown-toggle dropdown-mobile" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Maps</a>
                <div class="dropdown-menu">
                  <a class="dropdown-item" href="{{ '/maps/' | relative_url }}">About Maps</a>
                  <a class="dropdown-item" href="{{ '/tools/interactive-map' | relative_url }}">Interactive Map</a>
                  <a class="dropdown-item" href="{{ '/tools/earthtrack-app' | relative_url }}">Earthtrack App</a>
                </div>
              </li>

              <!-- KNOWLEDGE HUB (was Tools) -->
              <li class="nav-item pl-4 pl-md-0 ml-0 ml-lg-5 active dropdown-mobile">
                <a class="nav-link dropdown-toggle dropdown-mobile" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Knowledge Hub</a>
                <div class="dropdown-menu">
                  <a class="dropdown-item" href="{{ '/tools/' | relative_url }}">About Knowledge Hub</a>
                  <a class="dropdown-item" href="{{ '/tools/learn' | relative_url }}">Learn</a>
                  <a class="dropdown-item" href="{{ '/tools/for-developers' | relative_url }}">For Developers</a>
                </div>
              </li>

              <!-- THEMES -->
              <li class="nav-item pl-4 pl-md-0 ml-0 ml-lg-5 active dropdown-mobile">
                <a class="nav-link dropdown-toggle dropdown-mobile" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Themes</a>
                <div class="dropdown-menu">
                  <a class="dropdown-item" href="{{ '/themes/' | relative_url }}">About Themes</a>
                  <a class="dropdown-item" href="{{ '/themes/landhabcover/' | relative_url }}">Land Cover and Habitats</a>
                  <a class="dropdown-item" href="{{ '/themes/change/' | relative_url }}">Change, Impacts and Pressures</a>
                  <a class="dropdown-item" href="{{ '/themes/biodiversity/' | relative_url }}">Biodiversity</a>
                </div>
              </li>

              <!-- NEWS AND EVENTS -->
              <li class="nav-item pl-4 pl-md-0 ml-0 ml-lg-5 active">
                <a class="nav-link" href="{{ '/news' | relative_url }}">News and Events</a>
              </li>

            </ul>
          </div>

        </nav>
      </div>
    </div>
  </div>
</header>

{% if page.layout != 'home' %}
  <div class="otherpage-header-margin"></div>
{%- endif -%}