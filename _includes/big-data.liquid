<div class="container-fluid">
  {% if include.header %}
    <div class="section-hero-text">
      <p>{{ include.header }}</p>
    </div>
  {% endif %}
  {% if include.title %}
    <div class="row">
      <p class="new-about-title col-12">
        {{ include.title }}
      </p>
    </div>
  {% endif %}
  {% assign data = site.data['big-data'].index %}
  <div class="grid-columns grid-columns-px-15">
    <div class="row">
      {% for item in data %}
        <div class="col-12 col-sm-6 col-md-4 grid-item">
          <div class="img-container">
            <a href="{% if item.url contains 'http' %}{{ item.url }}{% else %}{{ item.url | relative_url }}{% endif %}"{% if item.newtab %} target="_blank" rel="noopener"{% endif %}>
              <img src="{% if item.image contains 'http' %}{{ item.image }}{% else %}{{ item.image | relative_url }}{% endif %}" class="img-fluid" alt="{{ item.title }}">
            </a>
          </div>
          <div class="grid-item-content">
            <a class="grid-item-title" href="{% if item.url contains 'http' %}{{ item.url }}{% else %}{{ item.url | relative_url }}{% endif %}"{% if item.newtab %} target="_blank" rel="noopener"{% endif %}>{{ item.title }}</a>
            <p class="grid-item-subtitle">{{ item.subtitle }}</p>
            {% if item.content %}<p class="grid-item-desc">{{ item.content }}</p>{% endif %}
            {% if item.tagline %}<p class="grid-item-tagline">{{ item.tagline }}</p>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
