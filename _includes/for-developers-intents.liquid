{%- comment -%}
FOR DEVELOPERS INTENT GRID — "What do you want to do?"
Data lives in _data/for-developers-intents.yml (title, description, icon, url).
Each card is a plain anchor link jumping to a section further down the page.
Doubles as this page's navigation, replacing the standard jump-nav pill row.
{%- endcomment -%}
<div class="fd-intents">
  <h2 class="fd-intents-heading">What do you want to do?</h2>
  <div class="fd-intents-grid">
    {% for item in site.data['for-developers-intents'] %}
      <a class="fd-intent-card" href="{% if item.url contains 'http' %}{{ item.url }}{% elsif item.url contains '#' %}{{ item.url }}{% else %}{{ item.url | relative_url }}{% endif %}">
        <span class="fd-intent-icon">
          {% if item.icon == 'download' %}
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
          {% elsif item.icon == 'globe' %}
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12.75 3.03v.568c0 .334.148.65.405.864l1.068.89c.442.369.535 1.01.216 1.49l-.51.766a2.25 2.25 0 0 1-1.161.886l-.143.048a1.107 1.107 0 0 0-.57 1.664c.369.555.169 1.307-.427 1.605L9 13.125l.423 1.059a.956.956 0 0 1-1.652.928l-.679-.906a1.125 1.125 0 0 0-1.906.172L4.5 15.75l-.612.153M12.75 3.031a9 9 0 0 0-8.862 12.872M12.75 3.031a9 9 0 0 1 6.69 14.036m0 0-.177-.529A2.25 2.25 0 0 0 17.128 15H16.5l-.324-.324a1.453 1.453 0 0 0-2.328.377l-.036.073a1.586 1.586 0 0 1-.982.816l-.99.282c-.55.157-.894.702-.8 1.267l.073.438c.08.474.49.821.97.821.846 0 1.598.542 1.865 1.345l.215.643m5.276-3.67a9.012 9.012 0 0 1-5.276 3.67m0 0a9 9 0 0 1-10.275-4.835M15.75 9c0 .896-.393 1.7-1.016 2.25"/></svg>
          {% elsif item.icon == 'analyse' %}
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z"/></svg>
          {% elsif item.icon == 'cloud' %}
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 0 0 4.5 4.5H18a3.75 3.75 0 0 0 1.332-7.257 3 3 0 0 0-3.758-3.848 5.25 5.25 0 0 0-10.233 2.33A4.502 4.502 0 0 0 2.25 15Z"/></svg>
          {% endif %}
        </span>
        <span class="fd-intent-title">{{ item.title }}</span>
        <span class="fd-intent-description">{{ item.description }}</span>
      </a>
    {% endfor %}
  </div>
</div>
