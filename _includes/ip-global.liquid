<div class="container">
  {% if include.header %}
    <div class="section-hero-text">
      <p>{{ include.header }}</p>
    </div>
  {% endif %}
  {% if include.title %}
    <div class="row">
      <p class="new-about-title col-12">
        {{ include.title }}
      </p>
    </div>
  {% endif %}
  {% assign data = site.data['themes']['change']['ip']['global'].index %}
  <div class="grid-columns grid-columns-px-15">
    <div class="row">
      {% for item in data limit: 3 %}
        <div class="col-12 col-sm-6 col-md-4 grid-item">
          <div class="img-container">
            {% if forloop.index0 == 0 %}
              <a href="{% if item.url contains 'http' %}{{ item.url }}{% else %}{{ item.url | relative_url }}{% endif %}"><img src="{% if item.image contains 'http' %}{{ item.image }}{% else %}{{ item.image | relative_url }}{% endif %}" class="img-fluid" alt="Living Earth logo"></a>
            {% elsif forloop.index0 == 1 %}
              <a href="{% if item.url contains 'http' %}{{ item.url }}{% else %}{{ item.url | relative_url }}{% endif %}"><img src="{{ '/assets/img/heading/vegheader.png' | relative_url }}" class="img-fluid" alt="Living Earth logo"></a>
            {% elsif forloop.index0 == 2 %}
              <a href="{% if item.url contains 'http' %}{{ item.url }}{% else %}{{ item.url | relative_url }}{% endif %}"><img src="{{ '/assets/img/heading/cropheader1.png' | relative_url }}" class="img-fluid" alt="Living Earth logo"></a>
            {% endif %}
          </div>
          <div class="grid-item-content">
            <a class="grid-item-title" href="{% if item.url contains 'http' %}{{ item.url }}{% else %}{{ item.url | relative_url }}{% endif %}">{{ item.title }}</a>
            <p class="grid-item-subtitle">{{ item.subtitle }}</p>
            <p class="grid-item-desc">{{ item.content | markdownify | raw }}</p>
            <p class="grid-item-tagline">{{ item.tagline }}</p>
          </div>
        </div>
      {% endfor %}
      {% for item in data offset: 3 limit: 3 %}
        <div class="col-12 col-sm-6 col-md-4 grid-item">
          <div class="img-container">
            <a href="{% if item.url contains 'http' %}{{ item.url }}{% else %}{{ item.url | relative_url }}{% endif %}"><img src="{% if item.image contains 'http' %}{{ item.image }}{% else %}{{ item.image | relative_url }}{% endif %}" class="img-fluid" alt="Living Earth logo"></a>
          </div>
          <div class="grid-item-content">
            <a class="grid-item-title" href="{% if item.url contains 'http' %}{{ item.url }}{% else %}{{ item.url | relative_url }}{% endif %}">{{ item.title }}</a>
            <p class="grid-item-subtitle">{{ item.subtitle }}</p>
            <p class="grid-item-desc">{{ item.content | markdownify | raw }}</p>
            <p class="grid-item-tagline">{{ item.tagline }}</p>
          </div>
        </div>
      {% endfor %}
      {% for item in data offset: 6 %}
        <div class="col-12 col-sm-6 col-md-4 grid-item">
          <div class="img-container">
            <a href="{% if item.url contains 'http' %}{{ item.url }}{% else %}{{ item.url | relative_url }}{% endif %}"><img src="{% if item.image contains 'http' %}{{ item.image }}{% else %}{{ item.image | relative_url }}{% endif %}" class="img-fluid" alt="Living Earth logo"></a>
          </div>
          <div class="grid-item-content">
            <a class="grid-item-title" href="{% if item.url contains 'http' %}{{ item.url }}{% else %}{{ item.url | relative_url }}{% endif %}">{{ item.title }}</a>
            <p class="grid-item-subtitle">{{ item.subtitle }}</p>
            <p class="grid-item-desc">{{ item.content | markdownify | raw }}</p>
            <p class="grid-item-tagline">{{ item.tagline }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
