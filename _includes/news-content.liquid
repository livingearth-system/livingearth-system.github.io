<style>
  .news-blog .blog_item { display: flex; }
  .news-blog .blog_item > .item { flex: 1; display: flex; flex-direction: column; }
  .news-blog .stay-up-card { flex: 1; display: flex; flex-direction: column; transition: transform 0.3s ease, box-shadow 0.3s ease; overflow: hidden; position: relative; }
  .news-blog .stay-up-card .line-card { margin-top: auto; }
  .news-blog .stay-up-card:hover { transform: scale(1.03); box-shadow: 0 12px 28px rgba(35, 86, 123, 0.18); z-index: 2; }
  .news-blog .stay-up-card img, .news-blog .stay-up-card:hover img { transform: none !important; }
  .news-blog .stay-up-card .card-links { display: flex; flex-direction: column; gap: 6px; margin: 4px 0 20px; padding: 0 40px; }
  .news-blog .stay-up-card .card-links a { display: inline-flex; align-items: center; gap: 8px; margin: 0 !important; padding: 0 !important; font-size: 15px !important; line-height: 1.4 !important; font-weight: 600; color: #23567b; text-decoration: none; }
  .news-blog .stay-up-card .card-links a:hover { text-decoration: underline; }
</style>

<div class="news-header-container">
  <div class="news-header-search"{% unless site.show_news_search %} style="display:none"{% endunless %}>
    <input
      class="search-box"
      type="text"
      placeholder="Search by key word"
    >

    <button class="a-to-z">
      <img src="{{ '/assets/icon/icon-a-to-z.svg' | relative_url }}">
    </button>
  </div>

  <div class="news-header-option">
    <button id="all-button" class="header-button-1" data-category="all">
      <p>ALL (<span id="all-count">0</span>)</p>
    </button>
    <button id="research-button" class="header-button-2" data-category="research">
      <p>RESEARCH (<span id="research-count">0</span>)</p>
    </button>
    <button id="case-study-button" class="header-button-3" data-category="case-study">
      <p>CASE STUDY (<span id="case-study-count">0</span>)</p>
    </button>
    <button id="news-button" class="header-button-4" data-category="news">
      <p>NEWS (<span id="news-count">0</span>)</p>
    </button>
    <button id="events-button" class="header-button-5" data-category="events">
      <p>EVENTS (<span id="events-count">0</span>)</p>
    </button>
    <button id="art-button" class="header-button-7" data-category="art">
      <p>ART (<span id="art-count">0</span>)</p>
    </button>
    <button id="themes-button" class="header-button-8" data-category="themes">
      <p>THEMES (<span id="themes-count">0</span>)</p>
    </button>
    <button id="countries-button" class="header-button-9" data-category="countries">
      <p>COUNTRIES (<span id="countries-count">0</span>)</p>
    </button>
    <button id="other-button" class="header-button-6" data-category="other">
      <p>OTHER (<span id="other-count">0</span>)</p>
    </button>
  </div>
</div>
<div class="container mb-64 mt-64 blog-main">
  <div class="row">
    <div class="col-12 col-md-6 blog-main-left-img">
      <img src="{{ '/assets/img/news/landslides-fnqld.png' | relative_url }}" alt="">
    </div>
    <div class="col-12 col-md-6 blog-main-right">
      <div class="blog-main-right-dsc">
        <button type="button">{{ include['title-button'] }}</button>
        <h5>{{ include.heading }}</h5>
        <p>
          {{ include.subheading }}
        </p>
        <div class="user-profile">
          <div class="user-profile-img">
            <img src="{% if include.avatar contains 'http' %}{{ include.avatar }}{% else %}{{ include.avatar | relative_url }}{% endif %}" alt="user">
          </div>
          <div>
            <h2 class="user-name">{{ include.username }}</h2>
            <div class="user-status">
              <p class="user-status-date">{{ include['user-status-date'] }}</p>
              <p class="user-status-type">{{ include['user-status-type'] }}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- OUR-BLOG -->
<div class="container-fluid news-blog">
  <div class="mb-60">
    <div class="row mb-60">
      {% for infor in site.data['news-blog'].index %}
        {%- comment -%} Items with `hidden: true` in _data/news-blog/index.yml are kept but not shown {%- endcomment -%}
        {% if infor.hidden %}{% continue %}{% endif %}
        {%- comment -%} Cards whose href is empty or '#' are shown without a link {%- endcomment -%}
        {% assign has_link = false %}{% if infor.href and infor.href != '#' and infor.href != '' %}{% assign has_link = true %}{% endif %}
        {% capture card_href %}{% if infor.href contains 'http' %}{{ infor.href }}{% else %}{{ infor.href | relative_url }}{% endif %}{% endcapture %}
        <div class="col-xl-4 col-md-6 blog_item">
          <div class="item mt-60" data-category="{{ infor['category'] }}">
            <div class="stay-up-card">
              {% if has_link %}<a href="{{ card_href }}"{% if infor.href contains 'http' %} target="_blank" rel="noopener"{% endif %}>{% endif %}<img src="{% if infor.oldman-img contains 'http' %}{{ infor.oldman-img }}{% else %}{{ infor.oldman-img | relative_url }}{% endif %}" alt="">{% if has_link %}</a>{% endif %}
              <div>
                {% for button in infor.button %}
                  <button class="{{ button.class }}" data-category="{{ infor['category'] }}">
                    <p>{{ button.name }}</p>
                  </button>
                {% endfor %}
              </div>
              <p class="title-img">
                {% if has_link %}<a href="{{ card_href }}"{% if infor.href contains 'http' %} target="_blank" rel="noopener"{% endif %}>{{ infor.title }}</a>{% else %}<span>{{ infor.title }}</span>{% endif %}
              </p>
              <span class="body-img">{{ infor.subtitle }}</span>
              {% if infor.links %}<div class="card-links">{% for l in infor.links %}<a href="{{ l.url }}" target="_blank" rel="noopener"><span aria-hidden="true">&rarr;</span> {{ l.name }}</a>{% endfor %}</div>{% endif %}
              <div class="line-card"></div>
              <div class="date-card">
                <span>{{ infor.date }}</span>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<!-- /OUR-BLOG -->
<div class="container mb-100">
  <div class="row">
    <div class="col-3 m-auto text-center d-flex align-items-center justify-content-center flex-column">
      <p class="total-view">
        You are viewing <span id="current-view">0</span> of <span id="total-articles">0</span> articles
      </p>
      <button type="button" class="load-more-btn">Learn more</button>
    </div>
  </div>
</div>

<script>

    document.addEventListener('DOMContentLoaded', function () {
      const buttons = document.querySelectorAll('.news-header-option button');

      buttons.forEach(function (button) {
          button.addEventListener('click', function () {
              const category = button.dataset.category;

              document.querySelectorAll('.news-blog .blog_item').forEach(function(column) {
                  const itemsInColumn = column.querySelectorAll('.item');
                  let columnShouldBeVisible = false;

                  itemsInColumn.forEach(function (item) {
                      const itemCategory = item.dataset.category;

                      if (category === 'all' || category === itemCategory) {
                          columnShouldBeVisible = true;
                      }
                  });

                  // '' (not 'block') so the equal-height flex layout is kept
                  column.style.display = columnShouldBeVisible ? '' : 'none';
              });
          });
      });
  });

  document.addEventListener("DOMContentLoaded", function() {
      // Count rendered cards only, so hidden items aren't included
      var totalArticles = document.querySelectorAll('.news-blog .item').length;
      var currentViewSpan = document.getElementById("current-view");
      var totalArticlesSpan = document.getElementById("total-articles");

      var loadMoreBtn = document.querySelector(".load-more-btn");
      var articlesPerPage = 8;
      var currentPage = 1;

      if (totalArticlesSpan) {
          totalArticlesSpan.textContent = totalArticles;
      }

      function updateCurrentView() {
          var currentViewCount = Math.min(currentPage * articlesPerPage, totalArticles);
          if (currentViewSpan) {
              currentViewSpan.textContent = currentViewCount;
          }
      }

      updateCurrentView();

      if (loadMoreBtn) {
          loadMoreBtn.addEventListener("click", function() {
              currentPage++;
              updateCurrentView();
          });
      }
  });

      document.addEventListener("DOMContentLoaded", function() {
        var data = {{ site.data['news-blog'].index | jsonify }};
        var counts = {};
        var totalCount = 0;

        data.forEach(function(item) {
            if (item.hidden) { return; }
            var category = item['category'];
            if (counts[category] === undefined) {
                counts[category] = 0;
            }
            counts[category]++;
            totalCount++;
        });

        Object.keys(counts).forEach(function(category) {
            var count = counts[category];
            var countSpanId = category + "-count";
            var countSpan = document.getElementById(countSpanId);
            if (countSpan) {
                countSpan.textContent = count;
            }
        });

        var allCountSpan = document.getElementById("all-count");
        if (allCountSpan) {
            allCountSpan.textContent = totalCount;
        }
    });

        document.addEventListener('DOMContentLoaded', function () {
          const buttons = document.querySelectorAll('.news-header-option button');
          const items = document.querySelectorAll('.news-blog .item');
          const totalArticlesSpan = document.getElementById("total-articles");
          const currentViewSpan = document.getElementById("current-view");
          const loadMoreBtn = document.querySelector(".load-more-btn");

          let articlesPerPage = 8;
          let currentPage = 1;

      function updateCurrentView(category) {
          let currentViewCount = 0;
              items.forEach(function (item) {
              const itemCategory = item.dataset.category;
              if (category === 'all' || category === itemCategory) {
                  if (item.style.display !== 'none') {
                      currentViewCount++;
                  }
                }
              });
          if (currentViewSpan) {
              currentViewSpan.textContent = currentViewCount;
          }
      }

      function updateTotalArticles(category) {
          let totalArticlesCount = 0;
          items.forEach(function(item) {
              const itemCategory = item.dataset.category;
              if (category === 'all' || category === itemCategory) {
                  totalArticlesCount++;
              }
          });
          if (totalArticlesSpan) {
              totalArticlesSpan.textContent = totalArticlesCount;
          }
      }

      updateCurrentView('all');
      updateTotalArticles('all');

      buttons.forEach(function (button) {
          button.addEventListener('click', function () {
              const category = button.dataset.category;
              updateCurrentView(category);
              updateTotalArticles(category);
          });
      });

      if (loadMoreBtn) {
          loadMoreBtn.addEventListener("click", function() {
              currentPage++;
              updateCurrentView('all');
          });
      }
  });

      // search function
      document.addEventListener('DOMContentLoaded', ()=>{
        const buttonSearch = document.querySelector('.a-to-z')
        const inputSearch = document.querySelector('.search-box')
        buttonSearch.addEventListener('click', ()=>{
          searchFunction(inputSearch.value)
        })

        const searchFunction = (searchText) => {
            const blogs = document.querySelectorAll('.blog_item')
            blogs.forEach(blog => {
              const title = blog.querySelector('.title-img>a, .title-img>span')
              blog.style.display = title.textContent.toUpperCase().includes(searchText.toUpperCase()) ? '' : 'none'
            })
        }
      })
</script>