{%- comment -%}
LEARN INTENT GRID — "What do you want learn about?"
Data lives in _data/learn-intents.yml (title, description, icon, url).
Same card pattern as _includes/for-developers-intents.liquid.
{%- endcomment -%}
<div class="fd-intents">
  <h2 class="fd-intents-heading">What do you want to learn about?</h2>
  <div class="fd-intents-grid fd-intents-grid-fill">
    {% for item in site.data['learn-intents'] %}
      {% if item.url == "#taxonomies" %}
      <button type="button" class="fd-intent-card learn-dropdown-toggle" aria-expanded="false" aria-controls="taxonomies">
      {% else %}
      <a class="fd-intent-card" href="{% assign first_char = item.url | slice: 0 %}{% if item.url contains 'http' or first_char == '#' %}{{ item.url }}{% else %}{{ item.url | relative_url }}{% endif %}">
      {% endif %}
        <span class="fd-intent-icon">
          {% if item.icon == 'book' %}
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/></svg>
          {% elsif item.icon == 'leaf' %}
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z"/></svg>
          {% elsif item.icon == 'tag' %}
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z"/></svg>
          {% elsif item.icon == 'academic-cap' %}
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 0 0-.491 6.347A48.627 48.627 0 0 1 12 20.904a48.627 48.627 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.57 50.57 0 0 0-2.658-.814A59.905 59.905 0 0 1 12 3.493a59.902 59.902 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443"/></svg>
          {% endif %}
        </span>
        <span class="fd-intent-title">{{ item.title }}</span>
        <span class="fd-intent-description">{{ item.description }}</span>
      {% if item.url == "#taxonomies" %}</button>{% else %}</a>{% endif %}
    {% endfor %}
  </div>
  {%- comment -%} Drop-down opened by the Taxonomies card. Content: page.taxonomies_blocks in tools/Learn/index.md {%- endcomment -%}
  <div class="learn-dropdown-panel" id="taxonomies" hidden>
    <div class="learn-dropdown-grid">
      {% for t in page.taxonomies_blocks %}
      <div class="learn-dropdown-item">
        <div class="learn-dropdown-item-head">
          {% if t.image %}<img src="{{ t.image | relative_url }}" alt="" class="learn-dropdown-item-icon">{% endif %}
          <h3 class="learn-dropdown-item-title">{{ t.title }}</h3>
        </div>
        <p class="learn-dropdown-item-text">{{ t.description }}</p>
        {% if t.links %}
          {% for link in t.links %}
          <a class="learn-dropdown-item-link" href="{% if link.url contains 'http' %}{{ link.url }}{% else %}{{ link.url | relative_url }}{% endif %}">{{ link.label }} &rarr;</a>
          {% endfor %}
        {% elsif t.url %}
          <a class="learn-dropdown-item-link" href="{% if t.url contains 'http' %}{{ t.url }}{% else %}{{ t.url | relative_url }}{% endif %}">{{ t.link_label | default: "Find out more" }} &rarr;</a>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
(function () {
  var toggle = document.querySelector('.learn-dropdown-toggle');
  var panel = document.getElementById('taxonomies');
  if (!toggle || !panel) return;
  function setOpen(open) {
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.classList.toggle('is-open', open);
  }
  toggle.addEventListener('click', function () { setOpen(panel.hidden); });
  // Links to /knowledge-hub/learn/#taxonomies open it straight away
  if (window.location.hash === '#taxonomies') {
    setOpen(true);
    setTimeout(function () { toggle.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 100);
  }
})();
</script>
