<!-- ORGANISATIONS -->
<div class="mt-80 mb-80 organisations-earth container">
    <div class="row">
        <div class="col-12">
            <p class="header">{{include.header}}</p>
        </div>
    </div>
    <div class="row">
        {% assign data = site.data['about']['organisations'].index %}
        {% for item in data %}
            <div class="col-md-6 col-lg-3 col-6 mb-40">
                <div class="organisations-earth-inner">
                    <div class="organisations-img">
                        {%- if item.image -%}<a href="{% if item.url contains 'http' %}{{ item.url }}{% else %}{{ item.url | relative_url }}{% endif %}"><img src="{% if item.image contains 'http' %}{{ item.image }}{% else %}{{ item.image | relative_url }}{% endif %}" alt="{{ item.name }}"></a>{% endif %}
                    </div>
                    <div class="organisations-dsc">
                        {%- if item.name -%}<h4>{{ item.name }}</h4>{% endif %}
                        {%- if item.subtitle -%}<p class="subtitle">{{ item.subtitle }}</p>{% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
<!-- /ORGANISATIONS -->