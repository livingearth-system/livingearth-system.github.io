From e836fe37acbc543c6d061b97644ee2f4536644ca Mon Sep 17 00:00:00 2001
From: Sienna Cuff <siennadcuff@gmail.com>
Date: Wed, 30 Sep 2026 17:15:36 +0300
Subject: [PATCH] Env descriptors: Snow renamed Snow and Ice, new Ice Extent
 card, readable link colours on data panels

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017FAU6c3gTUikd5hY6tiBJS
---
 _data/env-des-descriptors.yml                  |  10 +++++++++-
 _sass/livingearth/modules/env-descriptors.scss |   9 +++++++++
 assets/img/env_descriptors/ice-extent.jpg      | Bin 0 -> 485527 bytes
 3 files changed, 18 insertions(+), 1 deletion(-)
 create mode 100644 assets/img/env_descriptors/ice-extent.jpg

diff --git a/_data/env-des-descriptors.yml b/_data/env-des-descriptors.yml
index 590971fe..fd89b6f6 100644
--- a/_data/env-des-descriptors.yml
+++ b/_data/env-des-descriptors.yml
@@ -138,7 +138,7 @@
       description: "A measure of water turbidity. TSM includes both mineral and organic particles and affects light conditions in the water and the distribution of flora and fauna."
 
 - id: snow
-  title: "Snow"
+  title: "Snow and Ice"
   image: "/assets/img/wales/snow.jpg"
   descriptors:
     - title: "Snow Cover Fraction"
@@ -161,6 +161,14 @@
       unit: "cm"
       image: "/assets/img/wales/big/snow-depth.jpg"
       description: "The total depth of the snowpack, used to estimate the amount of snow covering the ground. Linked with snow water equivalent for water stock monitoring and flood forecasting."
+    - title: "Ice Extent"
+      unit: "area"
+      image: "/assets/img/env_descriptors/ice-extent.jpg"
+      description: "The total area covered by some amount of ice, including open water between ice floes. A typical threshold is 15% ice cover, for both land and water (freshwater to marine)."
+      links:
+        - label: "World Glacier Monitoring Service (WGMS)"
+          url: "https://wgms.ch/"
+          newtab: true
 
 - id: water
   title: "Water"
diff --git a/_sass/livingearth/modules/env-descriptors.scss b/_sass/livingearth/modules/env-descriptors.scss
index 848f93ac..70ee443b 100644
--- a/_sass/livingearth/modules/env-descriptors.scss
+++ b/_sass/livingearth/modules/env-descriptors.scss
@@ -962,4 +962,13 @@ button.env-des-descriptor-more {
 
 .env-des-descriptor-panel-link:hover {
   text-decoration: underline;
+}
+
+/* Keep links readable on the dark panels when hovered, clicked or visited
+   (otherwise Bootstrap turns them dark blue on the dark blue panel) */
+.env-des-descriptor-panel-block .env-des-descriptor-panel-link:hover,
+.env-des-descriptor-panel-block .env-des-descriptor-panel-link:focus,
+.env-des-descriptor-panel-block .env-des-descriptor-panel-link:active,
+.env-des-descriptor-panel-block .env-des-descriptor-panel-link:visited {
+  color: #c6e5f4;
 }
\ No newline at end of file
diff --git a/assets/img/env_descriptors/ice-extent.jpg b/assets/img/env_descriptors/ice-extent.jpg
new file mode 100644
index 0000000000000000000000000000000000000000..e1990ab9e30605b65948062a13db2caf95a8c1aa
